# ============================================================
# BHARAT — BUILD THE CIVILIZATION
# PART 4: ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ============================================================

# Application Environment
NODE_ENV=development
PORT=3000

# Client API Base URL
# Leave empty for same-origin dev/full-stack preview, or specify URL if running standalone backend
VITE_API_URL=

# Aiven MySQL Cloud Database Connection
# Obtain these credentials from your Aiven Console (https://console.aiven.io)
DB_HOST=your-mysql-service-name.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=your_secure_aiven_password
DB_NAME=bharat_db
DB_SSL=true

# JWT Authentication
JWT_SECRET=bharat_build_civilization_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# Google Gemini AI API Key (Acharya historical guide)
# AI Studio automatically injects GEMINI_API_KEY into server runtime from secrets.
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=

# Cloud Run / Deployment URL
APP_URL=https://your-deployment-url.run.app
